{
  "$description": "Noor Personal Portfolio — single source of truth for all design decisions. W3C DTCG format, importable into Figma via the 'Tokens Studio for Figma' plugin (enable 'Token Format: W3C DTCG' in plugin settings before importing). Edit values here, then run `npm run tokens` to regenerate design-system/generated/*.",
  "color": {
    "$type": "color",
    "brand": {
      "$description": "Primary purple identity. Dark-mode overrides live under color.dark.brand.",
      "primary": { "$value": "#6C4DF6", "$description": "Primary CTAs, links, active states" },
      "primaryDark": { "$value": "#4C32C3", "$description": "Hover / pressed states, gradient stops" },
      "accent": { "$value": "#8B5CF6", "$description": "Highlights, badges, secondary accents" },
      "onBrand": { "$value": "#FFFFFF", "$description": "Text/icons placed on a brand-filled surface" },
      "tint": { "$value": "#ECE8FE", "$description": "Subtle brand-tinted fill for badges, icon chips (solid — no alpha modifier needed)" },
      "glow": { "$value": "rgba(108, 77, 246, 0.25)", "$description": "Brand-tinted glow used by shadow.glow" }
    },
    "light": {
      "$description": "Light theme — mapped to :root by the token build.",
      "surface": {
        "bg": { "$value": "#F8F8FC", "$description": "Page background" },
        "card": { "$value": "#FFFFFF", "$description": "Card / panel backgrounds" },
        "muted": { "$value": "#F1F0F7", "$description": "Subtle alternating section background" },
        "scrim": { "$value": "rgba(248, 248, 252, 0.8)", "$description": "Translucent sticky-header background (pair with backdrop-blur)" }
      },
      "text": {
        "primary": { "$value": "#17151F", "$description": "Headings, primary body text" },
        "secondary": { "$value": "#6F6B7A", "$description": "Captions, meta text, muted copy (AA on card: 5.17:1)" }
      },
      "border": {
        "default": { "$value": "#E8E6EF", "$description": "Dividers, input borders, card outlines" }
      }
    },
    "dark": {
      "$description": "Dark theme — mapped to [data-theme=\"dark\"] by the token build. Not surfaced in v1 UI but fully wired.",
      "brand": {
        "primary": { "$value": "#8B6DF8" },
        "primaryDark": { "$value": "#6C4DF6" },
        "accent": { "$value": "#A78BFA" },
        "tint": { "$value": "#241E39" }
      },
      "surface": {
        "bg": { "$value": "#0E0D13" },
        "card": { "$value": "#17151F" },
        "muted": { "$value": "#1C1A26" },
        "scrim": { "$value": "rgba(14, 13, 19, 0.8)" }
      },
      "text": {
        "primary": { "$value": "#F5F4F8" },
        "secondary": { "$value": "#A6A2B4" }
      },
      "border": {
        "default": { "$value": "#2A2833" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": "Sora", "$description": "Headings — loaded via next/font (weights 600, 700)" },
      "body": { "$value": "Inter", "$description": "Body + UI — loaded via next/font (weights 400, 500, 600)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" },
      "5xl": { "$value": "3rem" }
    },
    "lineHeight": {
      "xs": { "$value": "1rem" },
      "sm": { "$value": "1.25rem" },
      "base": { "$value": "1.5rem" },
      "lg": { "$value": "1.75rem" },
      "xl": { "$value": "1.75rem" },
      "2xl": { "$value": "2rem" },
      "3xl": { "$value": "2.25rem" },
      "4xl": { "$value": "2.5rem" },
      "5xl": { "$value": "3.25rem" }
    },
    "letterSpacing": {
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base unit. Use for margin, padding and gap so rhythm stays consistent site-wide.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "7": { "$value": "1.75rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "14": { "$value": "3.5rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px", "$description": "Inputs, tags, small chips" },
    "md": { "$value": "12px", "$description": "Buttons, badges" },
    "lg": { "$value": "20px", "$description": "Cards, panels — soft/modern feel" },
    "full": { "$value": "9999px", "$description": "Pills, avatars" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px 0 rgba(23, 21, 31, 0.05)" },
    "md": { "$value": "0 4px 12px -2px rgba(23, 21, 31, 0.08), 0 2px 6px -2px rgba(23, 21, 31, 0.06)" },
    "lg": { "$value": "0 12px 32px -8px rgba(23, 21, 31, 0.12), 0 4px 12px -4px rgba(23, 21, 31, 0.08)" },
    "glow": {
      "$value": "0 0 0 1px rgba(108, 77, 246, 0.10), 0 8px 30px -6px rgba(108, 77, 246, 0.25)",
      "$description": "Signature premium-purple hover state for primary buttons / cards"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" },
      "slow": { "$value": "400ms" }
    },
    "loop": {
      "$type": "duration",
      "$description": "Ambient background loops — much slower than interaction durations, so they read as drift rather than animation.",
      "slow": { "$value": "18s" },
      "slower": { "$value": "26s" },
      "slowest": { "$value": "34s" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.4, 0, 0.2, 1], "$description": "Default easing for most transitions" },
      "entrance": { "$value": [0.16, 1, 0.3, 1], "$description": "Scroll-reveal / enter animations" }
    }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" }
    },
    "strokeWidth": { "$value": 1.75, "$description": "lucide-react stroke-width for visual consistency" }
  }
}
